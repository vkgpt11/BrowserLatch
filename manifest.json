{
  "manifest_version": 3,
  "name": "Only Listed Websites",
  "version": "1.0.0",
  "description": "Block web traffic except to websites on your local allowlist.",
  "minimum_chrome_version": "101",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Manage allowed websites"},
  "options_page": "options.html",
  "declarative_net_request": {"rule_resources": [{"id": "deny_default", "enabled": true, "path": "rules.json"}]},
  "web_accessible_resources": [{"resources": ["blocked.html", "styles.css", "blocked.js"], "matches": ["<all_urls>"]}]
}
