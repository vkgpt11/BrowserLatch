{
  "manifest_version": 3,
  "name": "BrowseLatch: Website Allowlist",
  "version": "1.4.0",
  "description": "Choose which websites open in Edge with password-protected allow and block lists.",
  "minimum_chrome_version": "102",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Manage BrowseLatch website rules"},
  "options_page": "options.html",
  "declarative_net_request": {"rule_resources": [{"id": "deny_default", "enabled": true, "path": "rules.json"}]},
  "web_accessible_resources": [{"resources": ["blocked.html", "styles.css", "blocked.js"], "matches": ["<all_urls>"]}]
}
